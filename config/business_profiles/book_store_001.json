  "uiProfile": {
    "dashboardVariant": "book_dashboard",
    "productCardVariant": "book_product_card",
    "heroAssetKey": "book_dashboard_hero",
    "navigationVariant": "book_navigation"
  },
  "theme": {
    "name": "book_editorial_theme",
    "primaryToken": "book_primary",
    "backgroundToken": "book_background",
    "useDynamicColor": false
  },
  "assets": {
    "iconKey": "book_app_icon",
    "logoKey": "book_logo",
    "dashboardHeroKey": "book_dashboard_hero",
    "emptyStateKey": "book_empty_state"
  }
