<?xml version="1.0" encoding="utf-8"?>
<!--
================================================
نام فایل: AndroidManifest.xml
وظیفه:
تعریف ساختار اصلی اپلیکیشن اندروید.

این فایل فقط تنظیمات اجرای برنامه را نگهداری می‌کند.
اطلاعات کسب‌وکار مانند نام فروشگاه و برند از Business Profile خوانده می‌شود.
نام نمایشی برنامه از App Config در زمان Build به @string/app_name تبدیل می‌شود.
================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- فقط برای Update Checker و Integrationهای اینترنتی قابل فعال‌سازی از Config استفاده می‌شود. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".WStoreApplication"
        android:theme="@style/Theme.WStoreEngine"
        android:label="@string/app_name">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
